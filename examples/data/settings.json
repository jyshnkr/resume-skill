{
  "schema": 1,
  "limits": {
    "words": [
      20,
      30
    ],
    "chars": 215,
    "text_pt": 540,
    "bullet_indent_pt": 18,
    "bullet_lines": [
      1,
      2
    ],
    "summary_lines": 4,
    "summary_sentences": 3
  },
  "bullets": {
    "banned_leads": [
      "helped",
      "responsible",
      "worked",
      "ensured",
      "assisted",
      "participated",
      "built",
      "designed"
    ],
    "irregular_past": [
      "led",
      "cut",
      "shrank",
      "drove",
      "ran",
      "won",
      "wrote",
      "rewrote",
      "rebuilt",
      "made",
      "set",
      "took",
      "grew",
      "sped",
      "held",
      "kept",
      "split",
      "oversaw",
      "taught",
      "brought",
      "sent",
      "spent",
      "found",
      "began",
      "chose",
      "drew",
      "sold",
      "bought",
      "stood",
      "upheld",
      "overcame",
      "undertook",
      "spun"
    ],
    "not_past": [
      "need",
      "speed",
      "feed",
      "seed",
      "embed",
      "breed",
      "proceed",
      "exceed",
      "succeed"
    ],
    "stop_words": [
      "a",
      "an",
      "and",
      "the",
      "of",
      "to",
      "by",
      "for",
      "in",
      "on",
      "with",
      "from",
      "into",
      "that",
      "as",
      "at",
      "or",
      "its",
      "each",
      "their",
      "all"
    ],
    "jargon": [
      "DoFn",
      "ParDo",
      "GroupByKey",
      "UICollectionView",
      "@PreAuthorize",
      "cy.intercept",
      "GSIs",
      "GSI"
    ],
    "aws_services": [
      "Lambda",
      "DynamoDB",
      "S3",
      "Glue",
      "CloudWatch",
      "Step Functions",
      "SQS",
      "SNS",
      "Secrets Manager",
      "SSM",
      "Athena",
      "API Gateway",
      "Route 53",
      "Cognito",
      "CloudFront",
      "KMS",
      "IAM",
      "EventBridge",
      "AppConfig",
      "Lake Formation",
      "Kinesis",
      "Fargate",
      "X-Ray",
      "ECS",
      "EKS",
      "RDS",
      "Aurora",
      "ElastiCache",
      "Redshift",
      "OpenSearch"
    ],
    "phrase_replacements": [
      {
        "pattern": "(?i)\\bcleared\\b",
        "say": "passed the review",
        "rule": 15
      }
    ],
    "require_aws_prefix": true
  },
  "summary": {
    "opening_pattern": "^[A-Z][A-Za-z ]+ with \\d+\\+ years of experience(, specializing)? in ",
    "retired_wording": []
  },
  "checks": {
    "short_last_line_pct": 50,
    "vague_ing_verbs": [
      "improving",
      "enhancing",
      "driving",
      "ensuring",
      "leveraging",
      "streamlining",
      "optimizing",
      "boosting",
      "fostering",
      "empowering"
    ],
    "robot_phrases_extra": [],
    "robot_phrases_ignore": []
  },
  "fit": {
    "weights": {
      "required": 70,
      "preferred": 30
    },
    "partial_credit": 0.5,
    "legend": {
      "5": 90,
      "4": 75,
      "3": 60,
      "2": 40
    },
    "legend_text": {
      "5": "strong fit, apply",
      "4": "good fit, apply",
      "3": "possible, your call",
      "2": "weak, skip unless you want a stretch",
      "1": "poor fit, skip"
    },
    "apply_lean_from": 4,
    "max_flags": 3,
    "min_rows": 3
  },
  "preferences": {
    "work_type": [
      "full-time",
      "contract"
    ],
    "location": "Austin, TX",
    "remote": "remote or hybrid",
    "minimum_rate": 70,
    "domains": [
      "logistics",
      "payments"
    ]
  },
  "output": {
    "font": "Times New Roman",
    "copy_resumes_to": null,
    "backup_copy_to": null
  }
}
